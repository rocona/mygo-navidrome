{
  "id": "navidrome",
  "name": "Navidrome",
  "version": "0.1.0",
  "minAppVersion": "0.1.8",
  "main": "index.js",
  "playback": "stream",
  "permissions": {
    "network": ["*"]
  },
  "imageSizes": [
    {
      "hosts": ["{setting:server}"],
      "query": { "size": "{size}" }
    }
  ],
  "settings": [
    {
      "key": "server",
      "label": "Server URL",
      "help": "Your Navidrome address, for example https://music.example.com or http://192.168.31.10:4533"
    },
    {
      "key": "username",
      "label": "Username"
    },
    {
      "key": "password",
      "label": "Password",
      "help": "Use a dedicated Navidrome account if possible. MyGo Music stores plugin settings locally."
    }
  ],
  "navigation": [
    { "builtin": "home" },
    { "builtin": "liked" },
    { "title": "Albums", "page": "albums", "icon": "album" },
    { "title": "Artists", "page": "artists", "icon": "artist" },
    { "title": "Playlists", "page": "playlists", "icon": "playlist" }
  ]
}
